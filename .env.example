# Language model (OpenAI-compatible API; LM Studio locally)
MODEL_BASE_URL=http://127.0.0.1:1234/v1
MODEL_NAME=
MODEL_API_KEY=none
# Optional: sent as reasoning_effort, e.g. none for reasoning models
MODEL_REASONING_EFFORT=

# Brave Search API (required)
BRAVE_SEARCH_API_KEY=

# A2A server
A2A_HOST=127.0.0.1
A2A_PORT=8000
A2A_AGENT_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Langfuse (self-hosted)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Research limits
MAX_PLANNER_ITERATIONS=2
MAX_SEARCHES_PER_REQUEST=6
MAX_RESULTS_PER_SEARCH=5
MAX_CLARIFICATION_ROUNDS=2
REQUEST_TIMEOUT_SECONDS=120
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
SEARCH_MIN_INTERVAL_SECONDS=1

LOG_LEVEL=INFO
