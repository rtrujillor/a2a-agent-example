                <mxCell id="tbl" value="&lt;table style=&#39;border-collapse:collapse;width:100%&#39;&gt;&lt;tr&gt;&lt;th style=&#39;background:#438DD5;color:#fff;padding:6px;text-align:left;border:1px solid #3C7FC0&#39;&gt;Logical component&lt;/th&gt;&lt;th style=&#39;background:#438DD5;color:#fff;padding:6px;text-align:left;border:1px solid #3C7FC0&#39;&gt;Physical implementation&lt;/th&gt;&lt;th style=&#39;background:#438DD5;color:#fff;padding:6px;text-align:left;border:1px solid #3C7FC0&#39;&gt;Location in repo&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Research Client&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;Vue.js SPA in the browser, served by Vite; A2A JS client&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;web client (new)&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Agent Interface&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;a2a-sdk Starlette app on Uvicorn; AgentCard; DefaultRequestHandler; InMemoryTaskStore&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;a2a/agent_card.py, server.py&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Workflow Orchestrator&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;LangGraph StateGraph, compiled once at startup&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;graph.py&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Request Classifier, Research Planner, Evidence Validator, Answer Synthesizer&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;LangGraph nodes&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;workflow/classifier.py, planner.py, validator.py, synthesizer.py&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Evidence Retriever&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;LangGraph node calling tool adapters over HTTPS&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;workflow/researcher.py, tools/&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Research State&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;Typed graph state + LangGraph InMemorySaver (thread_id = A2A contextId)&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;state.py, domain/&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Language Model Gateway&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;OpenAI-compatible chat model client; base URL points to LM Studio&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;config.py&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Configuration&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;Environment variables loaded from a git-ignored .env&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;config.py, .env.example&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Observability&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;Langfuse callback handler + Python logging&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;observability.py&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Agent Interface (bridge to workflow)&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;a2a-sdk AgentExecutor wrapping the compiled graph&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;a2a/executor.py&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Language Model Service&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;LM Studio local server (:1234, /v1)&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;external&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Web Search Service&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;Google Programmable Search, Custom Search JSON API&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;external&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Telemetry Service&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;Langfuse self-hosted via Docker Compose (:3000)&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;external&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;b&gt;Official &amp;amp; Public Data Sources&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;INE, BOE, Banco de España, MIVAU, regional and municipal portals&lt;/td&gt;&lt;td style=&#39;padding:6px;border:1px solid #cccccc;vertical-align:top&#39;&gt;&lt;code&gt;external&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontSize=11;" vertex="1" parent="1">
